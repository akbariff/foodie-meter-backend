# Neon: run `neon deploy` to pull both of these automatically. Pooled = app runtime, unpooled = migrations.
# For local Postgres instead, just set DATABASE_URL and omit DATABASE_URL_UNPOOLED.
DATABASE_URL="postgresql://user:password@localhost:5432/foodie_meter?schema=public"
DATABASE_URL_UNPOOLED=""

PORT=4477
NODE_ENV=development

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

VERIFICATION_CODE_TTL_MINUTES=15

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="your-16-char-app-password"
MAIL_FROM="Foodie Meter <your-gmail-address@gmail.com>"
