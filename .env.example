DATABASE_URL="postgresql://user:password@localhost:5432/foodie_meter?schema=public"

PORT=4477
NODE_ENV=development

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

VERIFICATION_CODE_TTL_MINUTES=15

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-gmail-address@gmail.com"
SMTP_PASS="your-16-char-app-password"
MAIL_FROM="Foodie Meter <your-gmail-address@gmail.com>"

# Local AI generation (Ollama runs on the same PC as this API)
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma3:4b"

# Optional: only for the local demo:users command; use unique 12+ character passwords
DEMO_PREMIUM_PASSWORD=""
DEMO_NUTRITIONIST_PASSWORD=""
